# Template only — every value below MUST stay empty.
# Copy to .env and fill it in there. .env is gitignored; this file is not.

GROQ_API_KEY=
MISTRAL_API_KEY=

# https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# Index NAME (not the UUID the console shows as "ID").
# Created automatically by `python ingest.py` if it doesn't exist.
PINECONE_INDEX=

# Logical partition inside the index. ingest.py writes here, app.py reads here —
# they must match exactly, or retrieval silently returns nothing.
PINECONE_NAMESPACE=
